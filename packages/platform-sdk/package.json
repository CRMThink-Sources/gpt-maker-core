{
  "name": "@gptmaker/platform-sdk",
  "version": "0.0.0",
  "private": true,
  "description": "Contrato do crmthink-platform: SDK TypeScript oficial (copiado) e tipos gerados do OpenAPI",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./api": {
      "types": "./dist/api.d.ts",
      "default": "./dist/api.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "generate": "openapi-typescript ../../docs/crmthink-platform-openapi.json -o src/api.gen.ts",
    "sync": "node scripts/sync.mjs"
  },
  "dependencies": {
    "jose": "^6.2.12"
  },
  "devDependencies": {
    "@types/node": "^24.13.6",
    "openapi-typescript": "^7.13.0",
    "vitest": "^4"
  }
}
