{
  "name": "gptmaker-bitrix",
  "private": true,
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/*",
    "backend",
    "frontend"
  ],
  "scripts": {
    "build": "npm run build -w @gptmaker/contracts -w @gptmaker/platform-sdk && npm run build -w backend && npm run build -w frontend",
    "lint": "eslint . && npm run lint -w frontend",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "depcruise": "npm run depcruise -w backend"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1"
  },
  "allowScripts": {
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "@swc/core@1.16.2": true
  },
  "overrides": {
    "openapi-typescript": {
      "typescript": "$typescript"
    }
  }
}
