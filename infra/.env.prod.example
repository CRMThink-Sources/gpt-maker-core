# Modelo do .env do Droplet. O deploy.yml grava o arquivo real a partir do secret ENV_FILE
# do GitHub Environment (staging/production) e acrescenta GHCR_OWNER; o IMAGE_TAG vem do deploy.
# Valores entre <> são do ambiente (staging ou produção). Roteiro: docs/staging.md.

# Domínios e TLS (Caddy emite os certificados; o DNS precisa apontar para o Droplet antes)
APP_DOMAIN=<app.dominio>
API_DOMAIN=<api.dominio>
ACME_EMAIL=joaovitor@crmthink.com.br

# Dados persistentes (DigitalOcean Volume montado pelo cloud-init)
DATA_DIR=/mnt/gptmaker-data

# Postgres: as credenciais aqui e na DATABASE_URL precisam ser as mesmas
POSTGRES_USER=gptmaker
POSTGRES_PASSWORD=<openssl rand -hex 24>
POSTGRES_DB=gptmaker

# RabbitMQ: as credenciais aqui e na RABBITMQ_URL precisam ser as mesmas
RABBITMQ_USER=gptmaker
RABBITMQ_PASSWORD=<openssl rand -hex 24>

# Backend
NODE_ENV=production
LOG_LEVEL=info
DATABASE_URL=postgres://gptmaker:<POSTGRES_PASSWORD>@postgres:5432/gptmaker
REDIS_URL=redis://redis:6379
RABBITMQ_URL=amqp://gptmaker:<RABBITMQ_PASSWORD>@rabbitmq:5672
# URL pública desta API: base dos webhooks que o GPTMaker chama (sem ela, vai localhost)
API_PUBLIC_URL=https://<api.dominio>
# Origens do frontend autorizadas por CORS a chamar a API
FRONTEND_ORIGINS=https://<app.dominio>

# GPTMaker (conta partner): token em https://app.gptmaker.ai/browse/developers.
# Um workspace por ambiente: o workspace-sync trata agentes de outro ambiente como órfãos.
GPTMAKER_API_TOKEN=<token>
GPTMAKER_WORKSPACE_ID=<workspace do ambiente>
# GPTMAKER_RATE_LIMIT_PER_SECOND=5
# TENANT_AGENT_LIMIT=5
# Limites de treinamento de quem ainda não tem plano (ex.: trial); com plano, vale o backoffice
# TRAINING_DEFAULT_MAX_TRAININGS=10
# TRAINING_DEFAULT_MAX_STORAGE_MB=50
# Fila das mensagens do chatbot: partições (ordem por diálogo) e esperas entre tentativas, em ms
# CHANNEL_INBOUND_PARTITIONS=4
# CHANNEL_RETRY_DELAYS_MS=10000,60000,300000
# Backoffice: sessão do operador (cookie httpOnly; Secure exige HTTPS, que a produção tem)
# BACKOFFICE_SESSION_IDLE_MINUTES=120
# BACKOFFICE_SESSION_MAX_HOURS=12
# BACKOFFICE_TOTP_ISSUER=ThinkFlow AI Backoffice
# Reconciliação diária com o consumo real do GPTMaker: fuso dos dias (a confirmar com o GPTMaker),
# tolerância por agente e dia, limite acima do qual o ajuste vai para revisão, dias reprocessados
# RECONCILIATION_TIMEZONE=America/Sao_Paulo
# RECONCILIATION_TOLERANCE_CREDITS=2
# RECONCILIATION_REVIEW_THRESHOLD_CREDITS=100
# RECONCILIATION_LOOKBACK_DAYS=3
# Preço do crédito GPTMaker para o partner, em centavos (fração aceita): custo e margem em reais
# no relatório do partner. Sem ele, o relatório mostra só créditos.
# GPTMAKER_CREDIT_COST_CENTS=

# crmthink-platform: código do app no cadastro (crmthink.thinkflow na produção,
# crmthink.homolog-thinkflow no staging; o frontend usa o mesmo), credentials.apiKey e
# credentials.webhookSecret do cadastro do app
# (aparecem uma vez). Na rotação do segredo: PLATFORM_WEBHOOK_SECRETS=novo,antigo por 24h.
APP_CODE=<código do app no ambiente>
PLATFORM_URL=https://<plataforma do ambiente>
PLATFORM_API_KEY=<apiKey>
PLATFORM_WEBHOOK_SECRETS=<webhookSecret>
# Portal CRMThink e SPAs (links do backoffice para Assinaturas e Instalações)
# CRMTHINK_PORTAL_URL=https://crmthink.bitrix24.com.br
# CRMTHINK_SPA_SUBSCRIPTIONS=1142
# CRMTHINK_SPA_INSTALLATIONS=1060
# BITRIX_RATE_LIMIT_PER_SECOND=2

# DigitalOcean Spaces (documentos de treinamento): chave em API → Spaces Keys, com acesso só
# ao bucket. Bucket privado; o GPTMaker baixa por URL pré-assinada (até 7 dias).
STORAGE_ENDPOINT=https://nyc3.digitaloceanspaces.com
STORAGE_REGION=nyc3
STORAGE_BUCKET=<bucket do ambiente>
STORAGE_ACCESS_KEY=<chave>
STORAGE_SECRET_KEY=<segredo>

# Frontend (lidas em tempo de execução pelo servidor Next, não no build)
PUBLIC_PLATFORM_URL=https://<plataforma do ambiente>
# API deste app (a mesma de API_PUBLIC_URL), chamada pelo navegador
PUBLIC_API_BASE_URL=https://<api.dominio>
# Chave publicável do Stripe do ambiente (pk_test_… em staging, pk_live_… em produção), para o checkout embutido.
PUBLIC_STRIPE_PUBLISHABLE_KEY=

# openssl rand -base64 32 (guardar com backup: sem ela os dados cifrados ficam ilegíveis)
DATA_ENCRYPTION_KEY=<chave>
