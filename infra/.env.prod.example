# Modelo do .env do Droplet. O deploy.yml grava o arquivo real a partir do secret ENV_FILE
# do GitHub Environment (staging/production) e acrescenta IMAGE_TAG e GHCR_OWNER.

# Domínios e TLS
APP_DOMAIN=app.exemplo.com.br
API_DOMAIN=api.exemplo.com.br
ACME_EMAIL=infra@exemplo.com.br
# Origens que podem embutir o frontend (portais Bitrix24), separadas por espaço
BITRIX_FRAME_ANCESTORS=https://*.bitrix24.com.br https://*.bitrix24.com

# Dados persistentes (DigitalOcean Volume)
DATA_DIR=/mnt/gptmaker-data

# Postgres
POSTGRES_USER=gptmaker
POSTGRES_PASSWORD=trocar
POSTGRES_DB=gptmaker

# RabbitMQ
RABBITMQ_USER=gptmaker
RABBITMQ_PASSWORD=trocar

# Backend
NODE_ENV=production
LOG_LEVEL=info
DATABASE_URL=postgres://gptmaker:trocar@postgres:5432/gptmaker
REDIS_URL=redis://redis:6379
RABBITMQ_URL=amqp://gptmaker:trocar@rabbitmq:5672
# GPTMaker (conta partner): token em https://app.gptmaker.ai/browse/developers
GPTMAKER_API_TOKEN=trocar
GPTMAKER_WORKSPACE_ID=trocar
# GPTMAKER_RATE_LIMIT_PER_SECOND=5
# TENANT_AGENT_LIMIT=5

# openssl rand -base64 32 (guardar com backup: sem ela os dados cifrados ficam ilegíveis)
DATA_ENCRYPTION_KEY=trocar
