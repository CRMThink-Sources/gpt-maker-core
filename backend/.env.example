NODE_ENV=development
APP_ROLE=api
PORT=3001
WORKER_HTTP_PORT=9464
LOG_LEVEL=debug
LOG_PRETTY=true
DATABASE_URL=postgres://gptmaker:gptmaker@localhost:5432/gptmaker
REDIS_URL=redis://localhost:6379
RABBITMQ_URL=amqp://gptmaker:gptmaker@localhost:5672
# Somente dev; em produção gerar com: openssl rand -base64 32
GPTMAKER_API_TOKEN=trocar
GPTMAKER_WORKSPACE_ID=trocar
FRONTEND_ORIGINS=http://localhost:3000
# Base dos webhooks do GPTMaker; em dev, o endereço do túnel para a porta 3001
API_PUBLIC_URL=http://localhost:3001
# crmthink-platform de staging; chave e segredo vêm do cadastro do app (POST /admin/apps)
APP_CODE=crmthink.homolog-thinkflow
PLATFORM_URL=https://platform-staging.crmthink.com.br
PLATFORM_API_KEY=trocar
PLATFORM_WEBHOOK_SECRETS=trocar
# Documentos de treinamento: SeaweedFS do docker-compose (S3). O GPTMaker baixa pela URL
# pré-assinada; para testar treinos de documento, exponha a porta 8333 num túnel e informe-o aqui.
STORAGE_ENDPOINT=http://localhost:8333
# STORAGE_PUBLIC_ENDPOINT=https://<tunel-do-storage>
STORAGE_ACCESS_KEY=gptmaker
STORAGE_SECRET_KEY=gptmaker123
STORAGE_FORCE_PATH_STYLE=true
# Ferramentas do agente sobre o CRM: o GPTMaker chama API_PUBLIC_URL/mcp e /gptmaker/crm/client
# (em dev, pelo túnel)
CRM_TOOLS_ENABLED=true
DATA_ENCRYPTION_KEY=ZGV2LWtleS1kZXYta2V5LWRldi1rZXktZGV2LWtleSE=

# Backoffice em http://localhost: cookie da sessão sem Secure (em produção, sempre com HTTPS)
BACKOFFICE_COOKIE_SECURE=false
